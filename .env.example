# Copy to .env.local for `vercel dev`, or set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API → service_role key (server-side only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → API → anon / publishable key. Public by design: it can only READ tournament_state
# (see supabase/migrations/002_realtime.sql). Optional: without it the browser polls every 5 s instead of using Realtime.
SUPABASE_ANON_KEY=
# Long random string used once to create the owner account
SETUP_TOKEN=
